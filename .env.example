# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-api03-tu_clave_aqui
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# --- Servidor ---
PORT=3000
PUBLIC_URL=https://pruebas-chat-bot-renove-plac.vercel.app

# --- Supabase ---
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key_aqui

# --- SMTP (contacto@renoveplac.com) ---
SMTP_HOST=smtp.tu_proveedor.com
SMTP_PORT=587
SMTP_USER=contacto@renoveplac.com
SMTP_PASS=tu_password_o_app_password
SMTP_FROM=Renoveplac <contacto@renoveplac.com>

# --- Admin ---
ADMIN_PASSWORD=cambia_esta_contrasena

# --- Webhook formulario WordPress ---
# Pon un valor aleatorio largo. WordPress debe enviar este mismo valor en el header X-Form-Secret.
FORM_SECRET=cambia_este_secreto_largo

# --- WhatsApp Cloud API (Meta) ---
# Configuracion para que el bot envie y reciba mensajes desde el numero de Renoveplac.
# Se generan en developers.facebook.com (App de Meta) y business.facebook.com (Business Manager).
# Sin estas variables, /api/whatsapp/webhook responde 200 pero el bot no contesta a los clientes.
#
# Verify token: cadena que inventas tu. Debe coincidir con el "Token de verificacion"
# que configures en el panel de Meta al dar de alta el webhook.
WHATSAPP_VERIFY_TOKEN=cadena_aleatoria_que_inventes
# App Secret: App Dashboard -> Configuracion de la aplicacion -> Basica -> Clave secreta de la app.
WHATSAPP_APP_SECRET=clave_secreta_de_la_app
# Token permanente del usuario de sistema (Business Manager -> Usuarios del sistema -> Generar token).
# Empieza por "EAA..." y nunca caduca. Permisos: whatsapp_business_messaging y whatsapp_business_management.
WHATSAPP_TOKEN=EAAxxxxxxxxxxx_token_permanente_del_usuario_de_sistema
# Phone Number ID: App Dashboard -> WhatsApp -> Configuracion de la API.
# NO es el numero de telefono, es un identificador numerico de 15-16 digitos.
WHATSAPP_PHONE_NUMBER_ID=identificador_del_numero_de_telefono
# WhatsApp Business Account ID (WABA ID): Business Manager -> Cuentas de WhatsApp -> Renoveplac.
# El codigo actual no lo usa en runtime, pero es util tenerlo a mano para llamadas a la Graph API
# (gestion de plantillas, suscripcion de webhooks via API, metricas, etc.).
WHATSAPP_BUSINESS_ACCOUNT_ID=identificador_de_la_cuenta_de_whatsapp_business
# Version de la Graph API. Si no se define, el codigo usa v21.0 por defecto.
WHATSAPP_API_VERSION=v21.0
